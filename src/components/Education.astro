---
import { educationData, certificationsData } from "../data/education";
---

<section id="education" class="sec" style="border-bottom: 0">
	<div class="eyebrow">Learning</div>
	<h2 class="sec-title"><span class="pr">~/</span>education</h2>
	<div class="cols" style="grid-template-columns: 1fr 1fr; gap: 48px">
		<div class="col">
			<div class="eyebrow">{educationData.year}</div>
			<h3>{educationData.degree}</h3>
			<p>{educationData.school}</p>
			<p>{educationData.summary}</p>
		</div>
		<div class="col">
			<div class="eyebrow">Certifications</div>
			<ul class="certs">
				{
					certificationsData.map((c) => (
						<li>
							<div>{c.name}</div>
							<span>{[c.issuer, c.year].filter(Boolean).join(" · ")}</span>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style>
	@media (max-width: 820px) {
		.cols {
			grid-template-columns: 1fr !important;
			gap: 32px !important;
		}
	}
</style>
